{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "60"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Edit(**/.env)",
      "Read(**/.env.local)",
      "Edit(**/.env.local)",
      "Read(**/.env.*.local)",
      "Edit(**/.env.*.local)",
      "Read(**/.env.development)",
      "Edit(**/.env.development)",
      "Read(**/.env.production)",
      "Edit(**/.env.production)",
      "Read(**/.env.staging)",
      "Edit(**/.env.staging)",
      "Read(**/.env.test)",
      "Edit(**/.env.test)",
      "Read(**/*.pem)",
      "Edit(**/*.pem)",
      "Read(**/*.key)",
      "Edit(**/*.key)",
      "Read(~/.ssh/**)",
      "Bash(rm -rf *)",
      "Bash(git push --force *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "./.env"
      ]
    }
  },
  "extraKnownMarketplaces": {
    "chessboost": {
      "source": {
        "source": "github",
        "repo": "zlarkisz/chessboost-team-marketplace"
      }
    }
  },
  "enabledPlugins": {
    "chessboost-toolkit@chessboost": true
  }
}
